# ─────────────────────────────────────────────────────────────────────────────
# Copy to server/.env for local dev, and set the same keys in your API host's
# environment settings (Render/Railway/Fly → Environment / Variables).
# Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED IN PRODUCTION.
# Without this the server refuses to start in production, on purpose: the
# embedded dev database lives on an ephemeral disk, so a hosted instance would
# silently lose every user, project and pending code on each restart.
# Leave it unset locally to use the zero-install embedded database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority

# Signs JWTs and the verification-code HMAC. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it invalidates all sessions and any in-flight verification codes.
JWT_SECRET=

PORT=5000

# Frontend origin(s) allowed by CORS, comma-separated. Leave empty for local
# dev (allows all). In production set your Netlify URL, no trailing slash:
# CLIENT_ORIGIN=https://your-site.netlify.app
CLIENT_ORIGIN=

# ── Email (verification codes + password reset) ──────────────────────────────
# Option 1 (REQUIRED on Render's free tier, and on any serverless host):
# Resend's HTTP API. Most free hosts block outbound SMTP ports (25/465/587) to
# stop spam, and the block shows up as a connection that hangs until it times
# out — no SMTP provider can work around it. This sends over HTTPS instead.
# Get a key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxx
#
# Leave MAIL_FROM unset to use onboarding@resend.dev, which delivers ONLY to
# the email that owns the Resend account — fine for testing. To email anyone
# else, verify a domain at https://resend.com/domains and set:
# MAIL_FROM=noreply@yourdomain.com

# Option 2: any SMTP provider — only works on hosts that permit outbound SMTP.
# SMTP_HOST=smtp.brevo.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@yourdomain.com

# Option 3: Gmail + App Password (local dev only — blocked on most hosts).
# Requires 2-Step Verification, then create a 16-char App Password at
# https://myaccount.google.com/apppasswords — spaces are stripped automatically.
# Caveats: ~500 messages/day, and Google revokes App Passwords after a password
# change, a 2FA change, or a long idle period — which is what makes codes
# mysteriously stop arriving weeks later. Check GET /api/health to confirm.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Shown as the sender name.
MAIL_FROM_NAME=TaskFlow

# Number of proxy hops in front of the API. 1 is right for Render/Netlify.
# Only raise it if you add another proxy — too high lets clients spoof their IP
# and bypass rate limiting.
TRUST_PROXY_HOPS=1

# Timezone used to bucket the dashboard's 7-day completion trend.
# TZ=Asia/Dhaka
